{% extends 'partials/base.html.twig' %}

{% block content %}
    <article class="page">
        <header class="page-header">
            <h1>{{ page.title }}</h1>
            {% if page.header.metadata is iterable and page.header.metadata.description is defined %}
            <p class="page-subtitle">{{ page.header.metadata.description }}</p>
            {% endif %}
        </header>
        <div class="page-body">
            {{ page.content|raw }}
        </div>
    </article>
{% endblock %}
